  "services": {
    "preset_save": {
      "name": "Save preset",
      "description": "Downloads the camera settings file (validated on the bridge) and stores it as /share/camera_presets/<preset>/<camera>.DAT.",
      "fields": {
        "device_id": {
          "name": "Bridge",
          "description": "a74_bridge devices; empty = all."
        },
        "preset": {
          "name": "Preset name",
          "description": "Folder name under /share/camera_presets; empty = date and time."
        },
        "note": {
          "name": "Note",
          "description": "Free text stored with the preset."
        }
      }
    },
    "preset_load": {
      "name": "Load preset",
      "description": "Uploads /share/camera_presets/<preset>/<camera>.DAT to the camera. The camera reboots (HDMI drops for about 11 s). Waits for verification.",
      "fields": {
        "device_id": {
          "name": "Bridge",
          "description": "a74_bridge devices; empty = all."
        },
        "preset": {
          "name": "Preset name",
          "description": "Folder name under /share/camera_presets."
        }
      }
    },
    "clock_sync": {
      "name": "Sync camera clock",
      "description": "Reads the camera clock and corrects it from the bridge when it is off by more than 2 s.",
      "fields": {
        "device_id": {
          "name": "Bridge",
          "description": "a74_bridge devices; empty = all."
        },
        "force": {
          "name": "Force",
          "description": "Correct even when the bridge has no NTP sync."
        }
      }
    },
    "set_properties": {
      "name": "Set camera properties",
      "description": "Raw SDK values, e.g. {\"iso\": 800, \"aperture\": 400}.",
      "fields": {
        "device_id": {
          "name": "Bridge",
          "description": "a74_bridge devices; empty = all."
        },
        "properties": {
          "name": "Properties",
          "description": "Object of property name (SDK name or alias) to raw value."
        }
      }
    },
    "record": {
      "name": "Recording",
      "description": "Start or stop recording on the cameras and the RØDECaster Video console together (the studio recording mode). Never called from schedules.",
      "fields": {
        "device_id": {
          "name": "Bridge",
          "description": "a74_bridge devices; empty = all."
        },
        "action": {
          "name": "Action",
          "description": "start or stop"
        },
        "jam": {
          "name": "Jam timecode first",
          "description": "Jam time-of-day timecode on the cameras before starting (default on)."
        },
        "fps": {
          "name": "Frame rate",
          "description": "Timecode frame rate for the jam."
        }
      }
    },
    "timecode_jam": {
      "name": "Jam timecode",
      "description": "Sets free-run time-of-day timecode on the cameras from the bridge clock (NTP). Refused while recording.",
      "fields": {
        "device_id": {
          "name": "Bridge",
          "description": "a74_bridge devices; empty = all."
        },
        "fps": {
          "name": "Frame rate",
          "description": "Timecode frame rate (25 for PAL studios)."
        }
      }
    },
    "preset_list": {
      "name": "List presets",
      "description": "Returns the preset library with metadata."
    },
    "preset_delete": {
      "name": "Delete preset",
      "description": "Removes a preset folder.",
      "fields": {
        "preset": {
          "name": "Preset name",
          "description": "Folder name under /share/camera_presets."
        }
      }
    },
    "sync_from": {
      "name": "Sync from camera",
      "description": "Copies settings from one camera to the others: parameters (exposure, WB, profile, format; no reboot) or full (settings file, reboots the targets).",
      "fields": {
        "device_id": {
          "name": "Target bridges",
          "description": "Targets; empty = all other cameras."
        },
        "source": {
          "name": "Source camera",
          "description": "Bridge name, e.g. a74-bridge-1."
        },
        "mode": {
          "name": "Mode",
          "description": "parameters or full"
        }
      }
    },
    "focus_refresh": {
      "name": "Refresh focus",
      "description": "Cancels a touch/tracking focus lock so face recognition in the Wide area takes over again. Allowed while recording.",
      "fields": {
        "device_id": {
          "name": "Bridge",
          "description": "a74_bridge devices; empty = all."
        }
      }
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Studio presets",
        "data": {
          "source_camera": "Source camera for sync (bridge name)",
          "guard_entity": "Session guard entity (while on: no preset save/load/sync, they blank the HDMI output)"
        }
      }
    }
  }
