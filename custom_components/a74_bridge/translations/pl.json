{
  "config": {
    "step": {
      "user": {
        "title": "Mostek A74",
        "description": "Adres mostka Raspberry Pi i token z /etc/a74-bridge/bridge.env.",
        "data": {
          "host": "Host",
          "port": "Port",
          "token": "Token"
        }
      }
    },
    "error": {
      "cannot_connect": "Nie można połączyć się z mostkiem",
      "invalid_auth": "Zły token",
      "no_camera": "Mostek odpowiada, ale nie zgłasza kamery"
    },
    "abort": {
      "already_configured": "Ten mostek jest już dodany"
    }
  },
  "entity": {
    "sensor": {
      "usb_mode": {
        "name": "Tryb USB"
      },
      "firmware": {
        "name": "Firmware kamery"
      },
      "active_preset": {
        "name": "Aktywny preset"
      },
      "last_job": {
        "name": "Ostatni load"
      },
      "clock_delta": {
        "name": "Odchyłka zegara"
      },
      "pi_temp": {
        "name": "Temperatura Pi"
      },
      "disconnects": {
        "name": "Rozłączenia USB"
      },
      "bridge_uptime": {
        "name": "Uptime mostka"
      },
      "battery_percent": {
        "name": "Bateria kamery"
      }
    },
    "binary_sensor": {
      "connected": {
        "name": "Sesja SDK"
      },
      "recording": {
        "name": "Nagrywanie"
      },
      "usb_remote_shooting": {
        "name": "USB Remote Shooting"
      },
      "load_in_progress": {
        "name": "Wgrywanie presetu"
      },
      "clock_ok": {
        "name": "Zegar OK"
      },
      "overheating": {
        "name": "Przegrzanie"
      }
    },
    "button": {
      "clock_sync": {
        "name": "Synchronizuj zegar"
      },
      "reconnect": {
        "name": "Wznów sesję SDK"
      }
    },
    "switch": {
      "record": {
        "name": "Nagrywanie (ręcznie)"
      }
    }
  },
  "services": {
    "preset_save": {
      "name": "Save preset",
      "description": "Downloads the camera settings file (validated on the bridge) and stores it as /share/camera_presets/<preset>/<camera>.DAT.",
      "fields": {
        "device_id": {
          "name": "Bridge",
          "description": "a74_bridge devices; empty = all."
        },
        "preset": {
          "name": "Preset name",
          "description": "Folder name under /share/camera_presets."
        }
      }
    },
    "preset_load": {
      "name": "Load preset",
      "description": "Uploads /share/camera_presets/<preset>/<camera>.DAT to the camera. The camera reboots (HDMI drops for about 11 s). Waits for verification.",
      "fields": {
        "device_id": {
          "name": "Bridge",
          "description": "a74_bridge devices; empty = all."
        },
        "preset": {
          "name": "Preset name",
          "description": "Folder name under /share/camera_presets."
        }
      }
    },
    "clock_sync": {
      "name": "Sync camera clock",
      "description": "Reads the camera clock and corrects it from the bridge when it is off by more than 2 s.",
      "fields": {
        "device_id": {
          "name": "Bridge",
          "description": "a74_bridge devices; empty = all."
        },
        "force": {
          "name": "Force",
          "description": "Correct even when the bridge has no NTP sync."
        }
      }
    },
    "set_properties": {
      "name": "Set camera properties",
      "description": "Raw SDK values, e.g. {\"iso\": 800, \"aperture\": 400}.",
      "fields": {
        "device_id": {
          "name": "Bridge",
          "description": "a74_bridge devices; empty = all."
        },
        "properties": {
          "name": "Properties",
          "description": "Object of property name (SDK name or alias) to raw value."
        }
      }
    },
    "record": {
      "name": "Recording",
      "description": "Manual use from the panel only; automations never start or stop recording.",
      "fields": {
        "device_id": {
          "name": "Bridge",
          "description": "a74_bridge devices; empty = all."
        },
        "action": {
          "name": "Action",
          "description": "start or stop"
        }
      }
    }
  }
}
